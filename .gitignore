# ============================================
# QCU News Scraper - Git Ignore
# ============================================

# ----------------
# Environment & Secrets
# ----------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ----------------
# Firebase Credentials (CRITICAL - Never commit!)
# ----------------
config/firebase_config.json
config/firebase-*.json
config/firebase-key.json
config/serviceAccount*.json
*firebase*.json
*serviceAccount*.json
serviceAccountKey.json
*.key.json

# ----------------
# Facebook Cookies & Sessions (CRITICAL - Never commit!)
# ----------------
config/cookies.txt
config/facebook_cookies.txt
config/*cookies*
*.cookies.txt
cookies.txt
*.cookie
*.cookies

# ----------------
# Python & Bytecode
# ----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ----------------
# Virtual Environments
# ----------------
venv/
env/
ENV/
.venv/
.ENV/

# ----------------
# IDE & Editors
# ----------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ----------------
# Testing & Coverage
# ----------------
.pytest_cache/
tests/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ----------------
# Data, Dumps & Logs (Local artifacts)
# ----------------
data/logs/
data/*.sqlite
data/*.sqlite3
data/*.db
data/cache/
data/scraper_state.json
data/.lock
data/last_stats*.json
data/*.html
data/*.txt
data/debug*
*.log
geckodriver.log
chromedriver.log

# Playwright artifacts
playwright-report/
test-results/
.playwright/

# ----------------
# OS Files
# ----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----------------
# Temporary Files
# ----------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ----------------
# Images Downloaded (if stored locally)
# ----------------
data/images/
data/thumbnails/
