# ==============================================================================
# QCU Facebook Announcement Scraper - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure local values as needed.
# DO NOT commit .env or any credentials to Git!
# ==============================================================================

# Firebase / Firestore Database Configuration
# Path to Google Service Account JSON key (relative to project root or absolute)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_KEY_PATH=config/firebase-key.json

# Target Firestore collection for storing announcements (default: posts)
FIRESTORE_COLLECTION=posts

# Optional Authentication Cookies (Netscape format)
# Required ONLY if scraping private/restricted pages
# FACEBOOK_COOKIES_PATH=config/facebook_cookies.txt

# Scraper Execution Flags
# Set to 'true' to run browsers without visible window (default: true)
SCRAPER_HEADLESS=true

# Set to 'true' ONLY for local troubleshooting.
# WARNING: When true, raw HTML dumps may contain session data if cookies were loaded.
SAVE_DEBUG_DUMPS=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
